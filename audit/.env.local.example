# Copie ce fichier en `.env.local` (gitignore) pour lancer l'audit en local.
# En prod (GitHub Actions), ces valeurs vont dans Settings → Secrets/Variables, PAS ici.

OPENROUTER_API_KEY="sk-or-..."
# Bon compromis cout/qualite pour un audit hebdo. Alternatives :
# anthropic/claude-haiku-4.5 (le moins cher) · anthropic/claude-opus-4.8 (le plus fin).
OPENROUTER_MODEL="anthropic/claude-sonnet-4.6"

# Slack : 2 modes possibles.
#  a) Bot token (DSN style Symfony Notifier, comme lagrange) + canal cible :
SLACK_DSN="slack://xoxb-...@default?channel=peu-importe"
SLACK_CHANNEL="test-automatisation"
#  b) OU une Incoming Webhook (prioritaire si definie) :
# SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."
# Si rien n'est defini -> le rapport s'imprime au lieu d'aller sur Slack.

# Optionnel : en local, laisse vide -> API publique LanguageTool (rate-limite).
# LANGUAGETOOL_URL="http://localhost:8010/v2/check"
